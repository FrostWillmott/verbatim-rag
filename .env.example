# LLM API key for the endpoint below. A missing or empty key does not stop the
# stack from starting: it surfaces on the first query, not at startup, and the
# query fails with 503 naming the provider's own error rather than answering
# "no relevant information found".
OPENAI_API_KEY=

# Which model, and which OpenAI-compatible endpoint. Defaults are Groq's, shown
# here commented out: uncomment to point the stack at another provider, or at a
# model your key can actually reach — the default one is not available on every
# Groq account.
#LLM_MODEL=moonshotai/kimi-k2-instruct-0905
#LLM_API_BASE=https://api.groq.com/openai/v1/

# Path inside the container where Milvus Lite stores its database file
INDEX_PATH=/data/index.db

# Host port the frontend is published on. 8080 rather than 80 because binding a
# privileged port needs root on Linux and macOS.
FRONTEND_PORT=8080
